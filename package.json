{
  "name": "asciidoc-table-editor",
  "displayName": "AsciiDoc Table Editor",
  "publisher": "yyamamot",
  "description": "Edit AsciiDoc tables in a visual grid inside VS Code",
  "version": "0.0.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yyamamot/asciidoc-table-editor.git"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "keywords": [
    "asciidoc",
    "table",
    "vscode",
    "editor"
  ],
  "packageManager": "pnpm@10.30.3",
  "type": "commonjs",
  "engines": {
    "vscode": "^1.105.0",
    "node": ">=24.0.0"
  },
  "main": "./dist/extension.js",
  "icon": "assets/icon.png",
  "l10n": "./l10n",
  "activationEvents": [
    "onCommand:asciidocTable.showParserInfo",
    "onCommand:asciidocTable.openEditor",
    "onCommand:asciidocTable.formatTable",
    "onLanguage:asciidoc",
    "onLanguage:adoc"
  ],
  "contributes": {
    "languages": [
      {
        "id": "asciidoc",
        "aliases": [
          "AsciiDoc",
          "asciidoc",
          "adoc"
        ],
        "extensions": [
          ".adoc",
          ".asciidoc",
          ".asc"
        ]
      }
    ],
    "commands": [
      {
        "command": "asciidocTable.showParserInfo",
        "title": "%command.asciidocTable.showParserInfo.title%"
      },
      {
        "command": "asciidocTable.openEditor",
        "title": "%command.asciidocTable.openEditor.title%"
      },
      {
        "command": "asciidocTable.formatTable",
        "title": "%command.asciidocTable.formatTable.title%"
      }
    ],
    "keybindings": [
      {
        "command": "asciidocTable.openEditor",
        "key": "cmd+alt+t cmd+alt+e",
        "mac": "cmd+alt+t cmd+alt+e",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "%configuration.asciidocTable.title%",
      "properties": {
        "asciidocTable.format.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.asciidocTable.format.enabled.description%"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:toolchain": "node ./scripts/check-toolchain.mjs",
    "check:quality-baseline": "node ./scripts/check-quality-baselines.mjs",
    "audit:prod": "pnpm audit --prod",
    "audit:all": "pnpm audit",
    "lint": "eslint . --suppressions-location eslint-suppressions.json",
    "format": "node ./scripts/check-format-baseline.mjs --write",
    "format:check": "node ./scripts/check-format-baseline.mjs --check",
    "format:baseline": "node ./scripts/check-format-baseline.mjs --update-baseline",
    "build": "node ./scripts/build.mjs",
    "build:test": "tsc -p tsconfig.json",
    "dev:vscode": "node ./scripts/open-clean-vscode.mjs",
    "package:vsix": "node ./scripts/vsix.mjs package",
    "test:package": "pnpm run build && node ./scripts/check-preview-vendor.mjs && node ./scripts/vsix.mjs smoke",
    "install:vsix": "node ./scripts/vsix.mjs install",
    "uninstall:vsix": "node ./scripts/vsix.mjs uninstall",
    "test:unit": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration",
    "test:integration:host": "node ./scripts/run-integration-host.mjs",
    "test:integration:host:matrix": "node ./scripts/run-integration-host.mjs --target matrix",
    "test:coverage:core-app": "node ./scripts/run-core-app-coverage.mjs",
    "test:coverage:extension": "node ./scripts/run-extension-coverage.mjs",
    "test:coverage": "node ./scripts/run-coverage.mjs",
    "test:nightly:visual": "node ./scripts/nightly-visual.mjs",
    "perf:large-table": "node ./scripts/perf-large-table.mjs",
    "perf:preview-block-cells": "node ./scripts/perf-preview-block-cells.mjs",
    "perf:codelens": "node ./scripts/perf-codelens.mjs",
    "review:ui:deterministic": "node ./scripts/review-ui-llm.mjs",
    "review:ui:deterministic:scenario": "node ./scripts/review-ui-llm.mjs --single",
    "review:ui:llm": "node ./scripts/review-ui-llm.mjs --deprecated-llm-alias",
    "review:ui:llm:scenario": "node ./scripts/review-ui-llm.mjs --single --deprecated-llm-alias",
    "review:ui:feature": "node ./scripts/review-ui-feature.mjs",
    "verify:ui-change": "node ./scripts/verify-ui-change.mjs",
    "capture:clipboard-fixture": "node ./scripts/capture-macos-clipboard-fixture.mjs",
    "release:regression": "node ./scripts/release-regression.mjs",
    "release:check-version": "node ./scripts/check-release-version.mjs",
    "check:l10n": "node ./scripts/check-l10n.mjs",
    "check:asciidoctor-compat": "node ./scripts/check-asciidoctor-compat.mjs",
    "check": "pnpm run check:toolchain && pnpm run check:quality-baseline && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test:unit",
    "verify": "pnpm run build && pnpm run check:l10n && pnpm run check && pnpm run test:integration && pnpm run test:integration:host"
  },
  "files": [
    "assets/**",
    "dist/**",
    "l10n/**",
    "package.nls.json",
    "package.nls.ja.json",
    "README.md",
    "README.ja.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "dependencies": {
    "@asciidoctor/core": "3.0.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.12.3",
    "@types/vscode": "1.105.0",
    "@vitest/coverage-v8": "3.2.6",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.9.2",
    "axe-core": "4.12.1",
    "c8": "12.0.0",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "happy-dom": "20.9.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "3.2.6",
    "yauzl": "3.4.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch@5.1.9>brace-expansion": "2.1.4",
      "vite@7.3.6>esbuild": "0.28.1",
      "happy-dom@20.9.0>ws": "8.21.0",
      "typed-rest-client@1.8.11>qs": "6.15.2"
    }
  }
}
